        {"id": "feel_better", "label": "Feeling better day to day"},
        {"id": "digestion", "label": "Better digestion"},
        {"id": "blood_sugar", "label": "Steadier blood sugar"},
        {"id": "weight", "label": "My weight"},
        {"id": "energy", "label": "More energy"},
        {"id": "regular_meals", "label": "Eating more regularly"},
        {"id": "relationship", "label": "A calmer relationship with food"},
        {"id": "performance", "label": "Sports or training performance"},
        {"id": "other", "label": "Something else", "free_text": true}
      ]
    },
    {
      "id": "dietitian_note", "section": "goals", "kind": "interstitial",
